# ====================================
# CONFIGURATION COURT CIRCUIT
# ====================================

# === PORT ===
PORT=3000

# === SESSION ===
# IMPORTANT: Changez cette clé en production (minimum 32 caractères aléatoires)
SESSION_SECRET=votre-cle-secrete-super-longue-a-changer-en-production-123456789

# === MODE DÉVELOPPEMENT ===
# true = paiements simulés, false = vrais paiements HelloAsso
DEV_MODE=true

# === SUPABASE (Base de données gratuite) ===
# Obtenir sur: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre-cle-anon-publique
SUPABASE_SERVICE_KEY=votre-cle-service-privee

# === CLOUDINARY (Stockage d'images gratuit) ===
# Obtenir sur: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=votre-cloud-name
CLOUDINARY_API_KEY=votre-api-key
CLOUDINARY_API_SECRET=votre-api-secret

# === HELLOASSO (Paiements) ===
# Obtenir sur: https://www.helloasso.com/
HELLOASSO_CLIENT_ID=votre-client-id-helloasso
HELLOASSO_CLIENT_SECRET=votre-client-secret-helloasso
HELLOASSO_ORGANIZATION_SLUG=court-circuit
